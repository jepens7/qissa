{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // ES2021 adalah batas API yang tersedia di Android Chrome 90 (SRS NFR-6).
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src", "test"],
  // Tes yang memakai API Node (mis. menjalankan vite build) diperiksa lewat tsconfig.node.json.
  "exclude": ["test/**/*.node.test.ts"]
}
