# Salin menjadi apps/web/.env lalu isi (docs/DATA-CONTRACTS.md §1).
# Semua nilai VITE_* ikut ke bundel publik: jangan isi rahasia.

# Wajib. `vite build` gagal bila kosong.
VITE_SITE_URL=https://qissa.id
VITE_CONTENT_BASE=/content

# Opsional.
VITE_UMAMI_SCRIPT=
VITE_UMAMI_ID=
VITE_WA_CHANNEL=
VITE_PB_URL=

# Bila kosong, diambil dari "version" di apps/web/package.json.
VITE_APP_VERSION=
