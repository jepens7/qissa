# Nilai konfigurasi apps/web (docs/DATA-CONTRACTS.md §1).
# Lokal: salin menjadi apps/web/.env. Easypanel: isi nilai yang sama sebagai build arg (docs/PLAN.md E1).
# Semua nilai VITE_* ikut ke bundel publik: jangan isi rahasia.

# Wajib. `vite build` gagal bila kosong. Untuk staging: https://staging.qissah.id
VITE_SITE_URL=https://qissah.id
VITE_CONTENT_BASE=/content

# Opsional. Bila kosong, fiturnya mati tanpa error.
# Umami: skrip dari instance di umami.qissah.id; Website ID dari dasbor Umami (Settings → Websites).
# Skrip hanya dimuat bila keduanya terisi.
VITE_UMAMI_SCRIPT=https://umami.qissah.id/script.js
VITE_UMAMI_ID=
# Saluran WhatsApp: tautan saluran, misalnya https://whatsapp.com/channel/…
VITE_WA_CHANNEL=
# PocketBase untuk form masukan (SHR-3, setelah minggu 2): https://api.qissah.id
VITE_PB_URL=

# Bila kosong, diambil dari "version" di apps/web/package.json.
VITE_APP_VERSION=
